FROM ubuntu:24.04

# Pinned Toolchain Versions (derived from env/versions.env and backend/go.mod)
ARG GO_VERSION=1.26.4
ARG OMP_VERSION=18.1.22
ARG NODE_VERSION=22.22.2

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/go/bin:/root/.bun/bin:${PATH}"

# Install base OS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    tmux \
    unzip \
    tar \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install pinned Go compiler
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && go version

# Install Bun & Node
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Install pinned Oh My Pi (OMP) CLI binary
RUN bun add -g "@oh-my-pi/omp@${OMP_VERSION}" || npm install -g "@oh-my-pi/omp@${OMP_VERSION}" || true
# Verify real OMP binary version or link host binary
RUN which omp && omp --version || true

# Setup AgenticRemote working directories
WORKDIR /app
COPY backend/ ./backend/

# Build backend daemon binary
RUN cd backend && go build -o /usr/local/bin/agenticRemote ./cmd/agenticRemote

# Create TLS and configuration directories
RUN mkdir -p /etc/agenticremote/tls /app/.agenticremote/state /app/workspace

# Default production TLS daemon configuration
RUN echo '{\n\
  "stateDir": "/app/.agenticremote/state",\n\
  "workspaceRoot": "/app/workspace",\n\
  "listenAddr": "0.0.0.0:18765",\n\
  "publicEndpoint": "https://localhost:18765",\n\
  "tlsCertPath": "/etc/agenticremote/tls/server.crt",\n\
  "tlsKeyPath": "/etc/agenticremote/tls/server.key",\n\
  "terminalBackend": "pty",\n\
  "maxScrollbackBytes": 1048576,\n\
  "channelBufferSize": 100\n\
}' > /etc/agenticremote/config.json

EXPOSE 18765

ENTRYPOINT ["agenticRemote", "serve", "/etc/agenticremote/config.json"]
