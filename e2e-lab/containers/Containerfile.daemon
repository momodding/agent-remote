FROM oven/bun:latest

# Pinned Toolchain Versions (derived from env/versions.env and backend/go.mod)
ARG GO_VERSION=1.26.4
ARG OMP_VERSION=18.1.22

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/go/bin:/root/.bun/bin:${PATH}"

# Install minimal OS dependencies for daemon and tmux session management
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    tmux \
    tar \
    && rm -rf /var/lib/apt/lists/*

# Install pinned Go compiler
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && go version

# Install exact pinned Oh My Pi (OMP) CLI binary via @oh-my-pi/pi-coding-agent
RUN bun add -g "@oh-my-pi/pi-coding-agent@${OMP_VERSION}"

# Strict verification of real OMP binary version (fails build if binary missing or mismatched)
RUN which omp && omp --version

# Setup AgenticRemote working directories
WORKDIR /app
COPY backend/ ./backend/

# Build backend daemon binary
RUN cd backend && go build -o /usr/local/bin/agenticRemote ./cmd/agenticRemote

# Create state, TLS, and workspace directories
RUN mkdir -p /app/.agenticremote/state/tls /app/workspace /app/uploads

# Default production TLS daemon configuration matching backend/internal/config/config.go
RUN echo '{\n\
  "listenAddr": "0.0.0.0:18765",\n\
  "listenScheme": "https",\n\
  "publicEndpoint": "https://localhost:18765",\n\
  "stateDir": "/app/.agenticremote/state",\n\
  "workspaceRoot": "/app/workspace",\n\
  "uploadDir": "uploads",\n\
  "allowedCidrs": ["0.0.0.0/0", "::/0"],\n\
  "maxConnections": 16,\n\
  "maxSessions": 16,\n\
  "channelBufferSize": 256,\n\
  "maxScrollbackBytes": 1048576,\n\
  "allowDestructiveFiles": true,\n\
  "skipFingerprintVerification": false,\n\
  "pairingRotationSeconds": 300,\n\
  "terminalBackend": "tmux"\n\
}' > /app/.agenticremote/config.json


# Configure OMP v18 for deterministic mock provider
RUN mkdir -p /root/.omp/agent && echo '{\n\
  "providers": {\n\
    "deterministic": {\n\
      "baseUrl": "http://agenticremote-provider:19090/v1",\n\
      "api": "openai-completions",\n\
      "apiKey": "test-key",\n\
      "models": [\n\
        {\n\
          "id": "omni-deterministic",\n\
          "name": "Omni Deterministic",\n\
          "contextWindow": 128000,\n\
          "maxTokens": 4096,\n\
          "supportsTools": true\n\
        },\n\
        {\n\
          "id": "gpt-4o",\n\
          "name": "GPT-4o Mock",\n\
          "contextWindow": 128000,\n\
          "maxTokens": 4096,\n\
          "supportsTools": true\n\
        }\n\
      ]\n\
    }\n\
  }\n\
}' > /root/.omp/agent/models.json && echo '{\n\
  "modelRoles": {\n\
    "default": "omni-deterministic",\n\
    "smol": "omni-deterministic",\n\
    "slow": "omni-deterministic"\n\
  }\n\
}' > /root/.omp/agent/settings.json && \
  cp /root/.omp/agent/models.json /root/.omp/models.json && \
  cp /root/.omp/agent/settings.json /root/.omp/settings.json
EXPOSE 18765

ENTRYPOINT ["agenticRemote", "serve", "--config", "/app/.agenticremote/config.json"]
