FROM node:22-alpine

# Install bun
RUN npm install -g bun

# Install required system packages for Expo
RUN apk add --no-cache \
    python3 \
    make \
    g++

WORKDIR /app

# Copy client application
COPY client/ /app/

# Install dependencies
RUN bun install

# Build Expo web (static export)
RUN bun run web 2>&1 | tee /tmp/expo-build.log &
# Note: Expo web build happens at runtime via expo start --web
# For production, we just need the dev server ready

EXPOSE 8081

ENV EXPO_PUBLIC_API_URL=http://localhost:18765

# Start Expo dev server on web
CMD ["bun", "run", "web"]
