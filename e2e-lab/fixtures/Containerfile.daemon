FROM golang:1.24-bookworm AS builder
WORKDIR /app
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download
COPY backend/ ./backend/
RUN cd backend && CGO_ENABLED=0 go build -o /app/agenticRemote ./cmd/agenticRemote

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY --from=builder /app/agenticRemote /usr/local/bin/agenticRemote
RUN mkdir -p /root/.agenticremote

EXPOSE 8765
ENTRYPOINT ["/usr/local/bin/agenticRemote"]
CMD ["serve"]
