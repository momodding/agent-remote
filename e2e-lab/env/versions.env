# E2E Lab Pinned Versions
# Sourced by build scripts and CI/CD

# Docker Hub Android 14 release tag, pinned to its linux/amd64 content digest.
export ANDROID_IMAGE_REPO="budtmo/docker-android"
export ANDROID_IMAGE_TAG="emulator_14.0_v3.7.0-p0"
export ANDROID_IMAGE_DIGEST="sha256:7826cd345543736c9502293926f383af4ca9caf96bd47d12d15bce8d31fd9894"
export ANDROID_IMAGE="${ANDROID_IMAGE_REPO}:${ANDROID_IMAGE_TAG}@${ANDROID_IMAGE_DIGEST}"

# Android emulator configuration
export ANDROID_SDK_VERSION="34"
export ANDROID_API_LEVEL="34"

# Build configuration
export GRADLE_OPTS="-Xmx6144m -XX:+UseG1GC -XX:+ParallelRefProcEnabled"
export GRADLE_USER_HOME="/tmp/.gradle"
export EXPO_CACHE_DIR="/tmp/.expo"

# Podman preserves the caller's supplementary KVM-access group in rootless mode.
# budtmo/docker-android hardcodes container UID/GID 1300:1301 and its own
# change_permission() step tries to chown /dev/kvm to that UID/GID, which
# rootless Podman always rejects (no CAP_CHOWN over a device you don't own).
# --userns=keep-id:uid=1300,gid=1301 maps that baked-in identity onto the
# real host UID that actually holds the /dev/kvm access (a systemd-logind
# per-session ACL, not the kvm group), so /dev/kvm is already open()-able
# and the runner's patched emulator.py (see android/patches/emulator-kvm-fix.py)
# only needs to skip the impossible chown instead of performing one.
export CONTAINER_OPTS="--rm --device /dev/kvm --group-add keep-groups --userns=keep-id:uid=1300,gid=1301"
export ANDROID_EMULATOR_PORT_ADB="5555"

# E2E testing
export MAESTRO_FLOW_TIMEOUT="300"
export ADB_READINESS_TIMEOUT="300"

# Debug flags (set to 1 to expose noVNC on 6080)
export E2E_ANDROID_DEBUG="${E2E_ANDROID_DEBUG:-0}"
export E2E_VERBOSE="${E2E_VERBOSE:-0}"
export NOVNC_PORT="6080"

# Client dependencies (canonical from client/package.json)
export EXPO_VERSION="57.0.7"
export REACT_VERSION="19.2.3"
export REACT_NATIVE_VERSION="0.86.0"
export JS_ENGINE="hermes"

# Tools
export BUN_VERSION="1.3.14"
export NODE_TYPESCRIPT_VERSION="5.7.3"
export PLAYWRIGHT_TEST_VERSION="1.63.0"

# Runtime
export OMP_VERSION="18.1.22"
export GO_VERSION="1.26.4"

# Host environment
export PODMAN_VERSION="5.8.1"
export REQUIRE_KVM_DEVICE="/dev/kvm"
