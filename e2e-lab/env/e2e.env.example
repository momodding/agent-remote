# agenticRemote E2E Lab Environment Configuration Example
# Copy to e2e.env or export variables directly in your shell.

# Android Configuration
ANDROID_HOME=/home/momodding/android-sdk
ANDROID_SDK_ROOT=/home/momodding/android-sdk
AVD_NAME=omp_verify

# Server & Client Endpoints
DAEMON_HOST=127.0.0.1
DAEMON_PORT=18765
EXPO_WEB_PORT=8081

# Test Execution Flags
AGENTICREMOTE_STRICT_INTEGRATION=1
E2E_HEADLESS=1
E2E_LOG_LEVEL=info
