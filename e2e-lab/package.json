    "test:all": "bun run unified-runner/run-all.ts",
    "e2e": "bun run unified-runner/run-all.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10"
