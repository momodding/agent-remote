{
  "name": "agentic-remote-e2e-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Comprehensive Phase 1-4 E2E Lab for agenticRemote",
  "scripts": {
    "doctor": "bun run doctor/doctor.ts",
